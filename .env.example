# MHTL Wealth — environment variables
# Copy to .env and fill in. Never commit .env (see .gitignore).
# See .claude/orchestration-wealth-tracker/reports/tool-inventory.md for setup/verification status.

# --- Supabase (backend: DB, Auth, Edge Functions) ---
# Client-side (safe to ship in the app bundle, RLS protects the data):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (Edge Functions / Supabase secrets — NEVER put in the mobile client bundle):
SUPABASE_SERVICE_ROLE_KEY=

# --- Statement scanning (pivot v2, D33-D38 — replaces Powens/DSP2 aggregation) ---
# Server-side only (Edge Function that extracts scanned bank/PEA/assurance-vie/Veracash/
# Placement Direct statements via a vision model). NEVER put in the mobile client bundle.
ANTHROPIC_API_KEY=

# --- Binance (read-only API key on the user's own account, D14 — user generates this themselves) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Ledger on-chain tracking (D15 — public addresses only, never private keys/seed) ---
ETHERSCAN_API_KEY=
# Blockstream Esplora needs no API key (BTC)

# --- Stocks/ETF pricing (Twelve Data — Euronext Paris/PEA coverage) ---
TWELVE_DATA_API_KEY=

# --- Gold pricing ---
# gold-api.com needs no API key. Set GOLD_API_IO_KEY only if switching to GoldAPI.io for
# per-gram/per-karat endpoints (see research/asset-price-apis.md).
GOLD_API_IO_KEY=

# --- Crypto pricing ---
# CoinGecko free Demo API — no key required for basic price lookups.

# --- FX conversion ---
# Frankfurter.dev needs no API key.

# --- Push notifications (D21/D26 alerts) ---
EXPO_ACCESS_TOKEN=

# --- EAS / Expo (set via `eas init`, not manually) ---
EAS_PROJECT_ID=
